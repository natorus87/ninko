{
  "id": "template-subflow-orchestration",
  "name": "Subflow Orchestration",
  "description": "Ruft einen anderen Workflow als Subflow auf und verarbeitet dessen Ergebnis. Zeigt wie Workflows modular kombiniert werden können.",
  "nodes": [
    {
      "id": "node-1",
      "type": "trigger",
      "label": "Start",
      "config": {"mode": "manual"},
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "node-2",
      "type": "variable",
      "label": "Input vorbereiten",
      "config": {"name": "input_data", "value": "Test-Daten für Subflow"},
      "position": {"x": 400, "y": 100}
    },
    {
      "id": "node-3",
      "type": "subflow",
      "label": "Subflow aufrufen",
      "config": {"workflow_id": ""},
      "position": {"x": 700, "y": 100}
    },
    {
      "id": "node-4",
      "type": "condition",
      "label": "Subflow erfolgreich?",
      "config": {
        "expression": "output.contains('abgeschlossen')",
        "true_label": "OK",
        "false_label": "Fehler"
      },
      "position": {"x": 1000, "y": 100}
    },
    {
      "id": "node-5",
      "type": "variable",
      "label": "Erfolg loggen",
      "config": {"name": "subflow_status", "value": "erfolgreich"},
      "position": {"x": 1300, "y": 50}
    },
    {
      "id": "node-6",
      "type": "variable",
      "label": "Fehler loggen",
      "config": {"name": "subflow_status", "value": "fehlgeschlagen"},
      "position": {"x": 1300, "y": 150}
    },
    {
      "id": "node-7",
      "type": "end",
      "label": "Fertig",
      "config": {"status": "succeeded"},
      "position": {"x": 1600, "y": 100}
    }
  ],
  "edges": [
    {"id": "edge-1", "source_id": "node-1", "target_id": "node-2"},
    {"id": "edge-2", "source_id": "node-2", "target_id": "node-3"},
    {"id": "edge-3", "source_id": "node-3", "target_id": "node-4"},
    {"id": "edge-4", "source_id": "node-4", "target_id": "node-5", "label": "OK"},
    {"id": "edge-5", "source_id": "node-4", "target_id": "node-6", "label": "Fehler"},
    {"id": "edge-6", "source_id": "node-5", "target_id": "node-7"},
    {"id": "edge-7", "source_id": "node-6", "target_id": "node-7"}
  ],
  "variables": [
    {"name": "input_data", "value": ""},
    {"name": "subflow_status", "value": ""}
  ]
}
