{
  "id": "template-backup-verification",
  "name": "Backup Verification",
  "description": "Backup durchführen, verifizieren und bei Fehler alarmieren.",
  "nodes": [
    {
      "id": "node-1",
      "type": "trigger",
      "label": "Nächtlicher Cron",
      "config": {"mode": "cron", "cron": "0 2 * * *"},
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "node-2",
      "type": "agent",
      "label": "Backup starten",
      "config": {
        "agent_id": "orchestrator",
        "prompt": "Starte das nächtliche Backup gemäß der konfigurierten Backup-Strategie und melde das Ergebnis."
      },
      "position": {"x": 400, "y": 100}
    },
    {
      "id": "node-3",
      "type": "agent",
      "label": "Backup verifizieren",
      "config": {
        "agent_id": "orchestrator",
        "prompt": "Verifiziere das soeben erstellte Backup: {previous_output}. Antworte mit 'VERIFIZIERT', wenn das Backup vollständig und lesbar ist, sonst mit 'FEHLER'."
      },
      "position": {"x": 700, "y": 100}
    },
    {
      "id": "node-4",
      "type": "condition",
      "label": "Erfolgreich?",
      "config": {
        "expression": "output.contains('VERIFIZIERT')",
        "true_label": "Erfolg",
        "false_label": "Fehler"
      },
      "position": {"x": 1000, "y": 100}
    },
    {
      "id": "node-5",
      "type": "agent",
      "label": "Erfolg loggen",
      "config": {
        "agent_id": "orchestrator",
        "prompt": "Protokolliere den erfolgreichen Backup-Lauf: {previous_output}"
      },
      "position": {"x": 1300, "y": 50}
    },
    {
      "id": "node-6",
      "type": "agent",
      "label": "Alarm senden",
      "config": {
        "agent_id": "orchestrator",
        "prompt": "Das Backup ist fehlgeschlagen oder konnte nicht verifiziert werden. Sende einen Alarm an den Admin mit diesen Details: {previous_output}"
      },
      "position": {"x": 1300, "y": 150}
    },
    {
      "id": "node-7",
      "type": "end",
      "label": "Ende",
      "config": {"status": "succeeded"},
      "position": {"x": 1600, "y": 100}
    }
  ],
  "edges": [
    {"id": "edge-1", "source_id": "node-1", "target_id": "node-2"},
    {"id": "edge-2", "source_id": "node-2", "target_id": "node-3"},
    {"id": "edge-3", "source_id": "node-3", "target_id": "node-4"},
    {"id": "edge-4", "source_id": "node-4", "target_id": "node-5", "label": "Erfolg"},
    {"id": "edge-5", "source_id": "node-4", "target_id": "node-6", "label": "Fehler"},
    {"id": "edge-6", "source_id": "node-5", "target_id": "node-7"},
    {"id": "edge-7", "source_id": "node-6", "target_id": "node-7"}
  ],
  "variables": []
}
