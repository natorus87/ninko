# ── Core ────────────────────────────────────────────
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
LMSTUDIO_BASE_URL=http://YOUR_LMSTUDIO_HOST:1234/v1

CHROMA_HOST=chromadb
CHROMA_PORT=8000
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_FALLBACK=sqlite
SQLITE_SECRETS_KEY=

MAX_CONTEXT_TOKENS=4096
CONTEXT_RESET_THRESHOLD=0.75
RAG_TOP_K=5
MAX_OUTPUT_TOKENS=1024
LOG_LEVEL=INFO
LANGUAGE=de
ROUTING_EMBEDDING_ENABLED=true

# ── Auth / Login ────────────────────────────────────
API_AUTH_ENABLED=true
ADMIN_USERNAME=admin
# Optional: wenn gesetzt, wird dieses Passwort für den Admin-Login verwendet
ADMIN_PASSWORD=
# Fallback für Erststart, wenn ADMIN_PASSWORD leer ist
BOOTSTRAP_ADMIN_PASSWORD=
# Pflichtwert, mindestens 32 Zeichen. Generieren:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false

# ── Monitoring ──────────────────────────────────────
MONITOR_INTERVAL_SECONDS=300
MONITOR_AUTO_REMEDIATE=false

# ── Module aktivieren/deaktivieren ──────────────────
NINKO_MODULE_KUBERNETES=false
NINKO_MODULE_PROXMOX=true
NINKO_MODULE_GLPI=true
NINKO_MODULE_IONOS=true
NINKO_MODULE_FRITZBOX=true
NINKO_MODULE_HOMEASSISTANT=true
NINKO_MODULE_PIHOLE=true
NINKO_MODULE_WEB_SEARCH=true
NINKO_MODULE_DOCKER=true
NINKO_MODULE_LINUX_SERVER=true
NINKO_MODULE_WORDPRESS=false
NINKO_MODULE_TELEGRAM=false
NINKO_MODULE_EMAIL=false
NINKO_MODULE_CODELAB=true
NINKO_MODULE_IMAGE_GEN=false

# ── Modul: Pi-hole ───────────────────────────────────
PIHOLE_URL=http://YOUR_PIHOLE_HOST

# ── Modul: Kubernetes ───────────────────────────────
K8S_IN_CLUSTER=true
K8S_KUBECONFIG_PATH=
K8S_MONITOR_NAMESPACES=default,production

# ── Modul: Proxmox ──────────────────────────────────
PROXMOX_HOST=YOUR_PROXMOX_HOST
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=
PROXMOX_VERIFY_SSL=false
PROXMOX_CONFIRM_DESTRUCTIVE=true

# ── Modul: GLPI ─────────────────────────────────────
GLPI_BASE_URL=https://helpdesk.example.com
GLPI_DEFAULT_CATEGORY_ID=1
GLPI_DEFAULT_GROUP_ID=
GLPI_AUTO_CREATE_INCIDENTS=false
